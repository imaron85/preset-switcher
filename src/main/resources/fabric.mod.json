{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"${authors}"
	],
	"contact": {
		"homepage": "${homepage}",
		"sources": "${sources}",
		"issues": "${issues}"
	},
	"license": "${license}",
	"icon": "assets/presetswitcher/icon.png",
	"environment": "client",
	"languageAdapters": {
		"presetswitcher_early": "io.github.imaron85.presetswitcher.fabric.EarlyEntry"
	},
	"entrypoints": {
		"preLaunch": [
			"io.github.imaron85.presetswitcher.fabric.EarlyEntry"
		],
		"modmenu": [
			"io.github.imaron85.presetswitcher.fabric.ModMenuIntegration"
		]
	},
	"mixins": [
		"presetswitcher.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader}",
		"minecraft": "${minecraft}",
		"java": ">=${java}"
	},
	"suggests": {
		"modmenu": "*"
	}
}
